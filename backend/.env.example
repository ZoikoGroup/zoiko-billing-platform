# ── Zoiko Billing Platform — environment template ─────────────────────────
# Copy to .env and fill in. All values here are safe development defaults.
#
#   copy .env.example .env        (PowerShell)
#   cp .env.example .env          (bash)

# ── Database ──────────────────────────────────────────────────────────────
# Own database, separate from the main platform. Leave empty in development
# to use the SQLite fallback at app/data/billing_dev.sqlite3.
BILLING_DATABASE_URL=

# Example (Neon / PostgreSQL):
# BILLING_DATABASE_URL=postgresql+psycopg://billing_user:change-me@ep-example.neon.tech/zoiko_billing?sslmode=require

# ── JWT / Auth (own secret — never reuse the main platform's) ────────────
BILLING_SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
JWT_ISSUER=zoiko-billing-platform
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App Info ──────────────────────────────────────────────────────────────
APP_NAME=Zoiko Billing Platform Backend
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
BILLING_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174

# Public-facing frontend URL.
FRONTEND_URL=http://localhost:5173

# ── Email / SMTP ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@billing.zoiko.example
SMTP_USE_TLS=true

# ── Super Admin setup key ─────────────────────────────────────────────────
# Required to run scripts/seed_super_admin.py. Keep secret.
# IMPORTANT: unlike every other setting in this file, the script reads this
# via a raw shell environment variable (os.environ), NOT from this .env file
# -- setting it here alone does nothing for the script. Export it in your
# shell immediately before running the script, e.g.:
#   set SETUP_KEY=your-strong-random-value   (PowerShell/cmd)
#   export SETUP_KEY=your-strong-random-value  (bash)
# This line exists for reference/documentation only.
SETUP_KEY=

# ── Super Admin MFA (TOTP secrets encrypted at rest) ──────────────────────
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production (non-DEBUG); a DEBUG-only fallback key is derived
# automatically in development if left blank. Never reuse BILLING_SECRET_KEY.
MFA_ENCRYPTION_KEY=<SET_IN_SECRET_MANAGER>
MFA_ISSUER_NAME=Zoiko Billing
MFA_MAX_FAILED_ATTEMPTS=5
MFA_LOCKOUT_MINUTES=15
MFA_PENDING_TOKEN_EXPIRE_MINUTES=10

# ── Stripe — inert until filled in. Nothing requires these to boot. ──────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY_DEFAULT=usd
STRIPE_PAYMENT_METHOD_TYPES=card
STRIPE_BILLING_ADDRESS_COLLECTION=auto
# Plane 2 — Connect platform OAuth client_id (non-secret; required for tenant onboarding)
STRIPE_CONNECT_CLIENT_ID=
# Outbound transport hardening: bounded SDK retries + per-attempt timeout (seconds)
STRIPE_MAX_NETWORK_RETRIES=2
STRIPE_TIMEOUT_SECONDS=25
# Signed OAuth state token TTL (seconds) — CSRF protection for /stripe/connect/*
STRIPE_OAUTH_STATE_TTL_SECONDS=600

# ── Plane 1 — Zoiko's OWN Stripe account (commercial platform invoices) ────
# Separate from the Plane 2 STRIPE_* settings above. Used for self-serve
# Checkout of Zoiko-billing-the-org's own invoices (public invoice links).
# If both planes share one Stripe account, mirror the same key values here.
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_PUBLISHABLE_KEY=
PLATFORM_STRIPE_WEBHOOK_SECRET=

# ── Recurring-billing scheduler — OFF by default ──────────────────────────
# Flip to true once you're ready for dunning/recurring-billing/overdue-invoice
# background jobs to run against real data.
ENABLE_RECURRING_BILLING_SCHEDULER=false
BILLING_AUTO_EXPIRY_ENABLED=false
RECURRING_BILLING_INTERVAL_MINUTES=60
OVERDUE_INVOICE_CHECK_INTERVAL_MINUTES=60
DUNNING_PROCESS_INTERVAL_MINUTES=1440
ESCALATION_TO_COLLECTIONS_INTERVAL_MINUTES=1440
PROMISE_TO_PAY_CHECK_INTERVAL_MINUTES=1440
COMMERCIAL_DUNNING_INTERVAL_MINUTES=1440

# ── AI Model Gateway (chatbot LLM provider) ──────────────────────────────
# With no GROQ_API_KEY set, the chatbot runs fully deterministic rules-only.
GROQ_API_KEY=
GROQ_MODEL_DEFAULT=llama-3.3-70b-versatile
