# Backend origin the BROWSER calls.
#
# LEAVE THIS UNSET for normal deployments. The app then calls the SAME ORIGIN it
# was loaded from ("/api/..."), and the reverse proxy forwards /api to the
# FastAPI backend:
#   - dev:  the Vite dev server (vite.config.js server.proxy)
#   - prod: nginx (frontend/nginx.conf, and the VM's site config)
#
# Vite inlines VITE_* into the bundle at BUILD time, so anything set here ships
# to every visitor and is resolved on THEIR machine, not the server's. A
# loopback value here works only for whoever runs the backend locally and
# breaks sign-in for every other user.
#
# Set it ONLY when the API genuinely lives on a different origin than the
# frontend (split-host deployment). It must then be a real reachable origin,
# never a loopback address, and the backend's BILLING_CORS_ORIGINS must allow
# the frontend's origin.
# VITE_API_BASE_URL=

# Required only to run frontend/tests/super-admin-browser-login.spec.ts (Playwright).
# Never commit real values — set these in your shell or CI secret store.
# The account must be: role=super_admin, organization_id=NULL, is_active=true,
# is_verified=true. Do not use a platform_administrator-elevated account merely
# to make the QA spec pass — use the same effective privilege level QA is meant
# to validate.
SUPER_ADMIN_QA_EMAIL=
SUPER_ADMIN_QA_PASSWORD=
